# Cổng chạy backend
PORT=3000

# --- ElevenLabs (provider trả phí, hỗ trợ nhân bản giọng) ---
# Để trống thì provider ElevenLabs trả về 401 với thông báo rõ ràng.
# Key KHÔNG BAO GIỜ nằm trong app Flutter.
ELEVENLABS_API_KEY=

# --- Google TTS (provider mặc định, miễn phí) ---
# Không cần key: backend dùng endpoint TTS công khai của Google cho tiếng Việt.
# Nếu điền API key của Google Cloud Text-to-Speech, backend chuyển sang API chính thức:
# nhiều giọng tiếng Việt hơn và hỗ trợ điều chỉnh tốc độ đọc.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=vi-VN-Standard-A

# --- Xác thực app (tùy chọn) ---
# Danh sách API key mà app Flutter được phép dùng, phân tách bằng dấu phẩy.
# Để trống = không kiểm tra (phát triển cục bộ).
VVT_API_KEYS=

# --- TTS trên máy (miễn phí, không cần key) ---
# Đường dẫn tới Python để chạy sidecar scripts/tts_local.py.
# Đặt trống = tắt provider này (API sẽ báo chưa cấu hình).
LOCAL_TTS_PYTHON=
# Nơi lưu giọng đã nhân bản. Để trống = ~/.vietvoice/voices
LOCAL_TTS_VOICES_DIR=
#
# Cài đặt một lần:
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
#   pip install -r backend/requirements-tts.txt
#
# Lần nhân bản đầu tiên sẽ tải mô hình XTTS-v2 (~1.8GB) về máy, các lần sau
# dùng bản cache nên chạy ngay trên CPU.
